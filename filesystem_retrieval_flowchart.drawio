          <mxGeometry x="520" y="930" width="280" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="beam_stop" value="Repeat while F has expandable directories and done is false.&lt;br&gt;&lt;b&gt;Final: return top k top_candidate_ids + contents.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#dbe4ee;fillColor=#f8fafc;fontFamily=Arial;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
