          <mxGeometry x="1200" y="730" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="block_single" value="&lt;b&gt;Single block&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#475569&quot;&gt;merged_ids = ranked_0.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#dbe4ee;fillColor=#ffffff;fontColor=#0f172a;fontFamily=Arial;fontSize=14;spacing=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="935" y="855" width="300" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="block_parallel" value="&lt;b&gt;Parallel blocks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#475569&quot;&gt;Merge all ranked_i into merged_ids.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#dbe4ee;fillColor=#ffffff;fontColor=#0f172a;fontFamily=Arial;fontSize=14;spacing=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1410" y="855" width="310" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="block_global" value="&lt;b&gt;Deterministic merge&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#475569&quot;&gt;merged_ids = unique(L1 + L2 + ...); no global ranking after merge.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#dbe4ee;fillColor=#ffffff;fontColor=#0f172a;fontFamily=Arial;fontSize=14;spacing=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1130" y="955" width="500" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="block_update" value="&lt;b&gt;Split merged ids&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#475569&quot;&gt;append files(M) until |top_candidate_ids| = k; dirs(M) -&amp;gt; F_{t+1}.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#dbe4ee;fillColor=#ffffff;fontColor=#0f172a;fontFamily=Arial;fontSize=14;spacing=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1070" width="680" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="block_continue" value="&lt;b&gt;Continue?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#cbd5e1;fillColor=#ffffff;fontColor=#0f172a;fontFamily=Arial;fontSize=16;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1175" width="250" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="block_return" value="Stop when done, no expandable frontier, or max_turns.&lt;br&gt;&lt;b&gt;Final: return top k top_candidate_ids + contents.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#dbe4ee;fillColor=#f8fafc;fontFamily=Arial;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
