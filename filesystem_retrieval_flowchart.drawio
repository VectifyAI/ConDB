        </mxCell>
        <mxCell id="block_4" value="&lt;b&gt;LLM ranks each block&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#475569&quot;&gt;rank(C_i) -&amp;gt; ranked_i + done_i. These are returned candidates.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#dbe4ee;fillColor=#ffffff;fontColor=#0f172a;fontFamily=Arial;fontSize=14;spacing=12;shadow=1;" vertex="1" parent="1">
