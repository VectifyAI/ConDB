          <mxGeometry x="340" y="805" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="beam_file" value="&lt;b&gt;File&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#475569&quot;&gt;Add to top_candidate_ids A.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#dbe4ee;fillColor=#ffffff;fontColor=#0f172a;fontFamily=Arial;fontSize=14;spacing=12;shadow=1;" vertex="1" parent="1">
