          <mxGeometry x="960" y="360" width="710" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="block_2" value="&lt;b&gt;Create block specs from frontier&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#475569&quot;&gt;turn 0: top block. Later turns: subtree blocks from each frontier directory.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#dbe4ee;fillColor=#ffffff;fontColor=#0f172a;fontFamily=Arial;fontSize=14;spacing=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="450" width="710" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="block_3" value="&lt;b&gt;Candidate universe per block&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#475569&quot;&gt;For each block i: C_i = block.node_ids. Fields: path + type; metadata reserved, disabled.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#dbe4ee;fillColor=#ffffff;fontColor=#0f172a;fontFamily=Arial;fontSize=14;spacing=12;shadow=1;" vertex="1" parent="1">
